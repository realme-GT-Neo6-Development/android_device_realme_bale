# Bluetooth
bluetooth.device.default_name=realme GT Neo6

# Display
vendor.display.aspect_ratio_threshold=1

# Graphics
debug.sf.auto_latch_unsignaled=1
ro.surface_flinger.set_display_power_timer_ms=1000
ro.surface_flinger.set_idle_timer_ms=300
ro.surface_flinger.set_touch_timer_ms=350

# USB
vendor.usb.product_string=realme GT Neo6
